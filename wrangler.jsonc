{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "round-trip",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The React app is built by Vite into static assets. Requests for /api/* go
  // to the Worker first; every other unknown path falls back to index.html so
  // client-side routes like /c/<slug> work on refresh.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "round-trip",
      // ┌──────────────────────────────────────────────────────────────────┐
      // │ PLACEHOLDER: replace with the ID of your D1 database.            │
      // │ Create it with:  npx wrangler d1 create round-trip              │
      // │ (or Cloudflare dashboard → Storage & Databases → D1) and paste   │
      // │ the "database_id" it prints here.                                │
      // └──────────────────────────────────────────────────────────────────┘
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (not stored in this file):
  //   GOOGLE_PLACES_API_KEY – server-side key for Places API (New) + Routes API.
  //   Set it in the dashboard (Worker → Settings → Variables and Secrets) or
  //   with: npx wrangler secret put GOOGLE_PLACES_API_KEY
}
