{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pint-route",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "vars": {
    // Public address used in emailed links (password reset).
    "APP_URL": "https://pintroute.com",
    // Sender for emails. The domain must be verified in Resend.
    "EMAIL_FROM": "Pint Route <noreply@pintroute.com>"
  },

  // The React app is built by Vite into static assets. Requests for /api/* go
  // to the Worker first; every other unknown path falls back to index.html so
  // client-side routes like /c/<slug> work on refresh.
  "assets": {
    // Lets the Worker fetch the app's own files (env.ASSETS), e.g. index.html for /c/<slug>.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /c/* too, so shared crawl links get the crawl's name in their link preview.
    "run_worker_first": ["/api/*", "/c/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "round-trip-db",
      // ID of the D1 database "round-trip-db" (Cloudflare dashboard → Storage & Databases → D1).
      "database_id": "dea026b2-5a81-439a-ae35-1878b3284263",
      "migrations_dir": "migrations"
    }
  ],

  // Slows down password guessing on login/register: 10 attempts a minute per
  // email address, and a looser 60 a minute per IP (many phones share one IP on
  // mobile networks and pub Wi-Fi). namespace_id is any number unique in your account.
  "ratelimits": [
    {
      "name": "AUTH_EMAIL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]

  // Secrets (not stored in this file):
  //   GOOGLE_PLACES_API_KEY – server-side key for Places API (New) + Routes API.
  //   RESEND_API_KEY        – Resend API key for password-reset emails.
  //   Set them in the dashboard (Worker → Settings → Variables and Secrets) or
  //   with: npx wrangler secret put <NAME>
}
